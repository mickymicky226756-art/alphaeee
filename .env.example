# =====================================================================
# Alpha Trading Admin Panel — environment configuration
#
# Copy this file to ".env" and fill in your real values.  Restart the
# dev server after any change.
# =====================================================================

# --- Branding ---
VITE_ADMIN_BRAND_NAME=Alpha Trading

# --- Admin credentials (local auth) ---
# The reference default is 44 / a444. Change these before going live.
VITE_ADMIN_ID=44
VITE_ADMIN_PASSWORD=a444

# =====================================================================
# FIREBASE (required for live mode)
# =====================================================================
# Both this admin panel and the user-facing alpha-trading app must
# point at the SAME Firebase project so admin decisions are visible
# to users (and vice versa).
#
# How to fill these:
#   1. Open https://console.firebase.google.com
#   2. Create a project (or use an existing one)
#   3. Project settings → General → "Your apps" → register a Web app
#   4. Copy the config values into this file
#   5. In Build → Realtime Database, create a database (any region)
#   6. Set database rules to the rules in `database.rules.json` (shipped)
# =====================================================================

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
